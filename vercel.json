{
  "services": {
    "web": {
      "root": "web/",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "bindings": [{ "type": "service", "service": "presidio", "format": "url", "env": "PRESIDIO_URL" }]
    },
    "presidio": { "root": "presidio/", "framework": "fastapi", "entrypoint": "app:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
